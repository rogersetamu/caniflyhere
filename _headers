/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self)
  X-DNS-Prefetch-Control: on
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://js.arcgis.com https://pagead2.googlesyndication.com https://adservice.google.com; style-src 'self' 'unsafe-inline' https://js.arcgis.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://js.arcgis.com; connect-src 'self' https://services6.arcgis.com https://js.arcgis.com https://pagead2.googlesyndication.com; img-src 'self' data: blob: https://*.arcgis.com https://*.arcgisonline.com https://pagead2.googlesyndication.com; frame-src https://googleads.g.doubleclick.net; worker-src blob:;

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate
